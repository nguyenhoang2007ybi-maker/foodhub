PORT=3000
JWT_SECRET=foodhub_secret_key_production_2026_super_secure
NODE_ENV=development
ADMIN_EMAIL=admin@foodhub.vn
ADMIN_PASSWORD=Admin@FoodHub2026!

# ============================================================
# Cấu hình gửi email xác nhận (OTP) - KHÔNG bắt buộc để chạy dev
# ============================================================
# Nếu KHÔNG cấu hình, hệ thống vẫn tạo mã OTP thật và xác thực ở server,
# nhưng thay vì gửi mail, mã sẽ được in ra console server và trả về UI
# (chỉ khi NODE_ENV != production) để bạn kiểm thử.
#
# Muốn gửi email thật: đặt các biến dưới đây và cài nodemailer:
#   npm install nodemailer
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="FoodHub" <your-account@gmail.com>

